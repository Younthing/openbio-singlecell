  "cards": [
    {
      "dot": "cyan",
      "title": "进程隔离",
      "items": [
        "ComfyUI 主进程只编排请求、租约与 ArtifactTicket",
        "每次科学节点调用启动一个隔离 Worker，结束后不保留科学库工作区"
      ]
    },
    {
      "dot": "emerald",
      "title": "文件与缓存生命周期",
      "items": [
        "一个 RunLease 原子发布该次运行的全部 File artifacts",
        "缓存命中直接复用 ArtifactTicket，不启动 Worker；RAM-pressure cache 被拒绝"
      ]
    },
    {
      "dot": "amber",
      "title": "耐久边界",
      "items": [
        "Persisted artifact 是可移植文件产物的显式耐久副本",
        "scVI / cNMF 原生目录受 Worker identity 绑定，不能持久化或恢复"
      ]
    }
  ]
