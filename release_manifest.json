{
  "schema_version": 1,
  "product": "openbio-singlecell",
  "version": "0.2.0",
  "comfyui": {
    "commit": "924743af083c151296cc16f925aeab113b6484e8"
  },
  "comfyui_frontend": {
    "commit": "795292d90777efdfb92fc5d3f928dcf13a7cf8a8",
    "version": "1.52.3"
  },
  "toolchain": {
    "python": ">=3.12",
    "node": ">=25 <26",
    "pnpm": "11.13.1"
  },
  "python_dependencies": {
    "scanpy": ">=1.12.3,<1.13",
    "anndata": ">=0.13.2,<0.14"
  },
  "release_artifacts": {
    "custom_node": {
      "path": "openbio-singlecell",
      "license": "LICENSE",
      "third_party_notices": "THIRD_PARTY_NOTICES.md",
      "example_workflows": [
        "example_workflows/Quality Control and Clean Counts.json",
        "example_workflows/Cell Clustering and Marker Discovery.json",
        "example_workflows/Sample Composition Comparison.json",
        "example_workflows/scVI Batch Integration and Contrast.json"
      ],
      "workflow_covers": [
        "example_workflows/Quality Control and Clean Counts.jpg",
        "example_workflows/Cell Clustering and Marker Discovery.jpg",
        "example_workflows/Sample Composition Comparison.jpg",
        "example_workflows/scVI Batch Integration and Contrast.jpg"
      ],
      "contract": {
        "node_id_prefix": "OpenBioSingleCell",
        "category_prefix": "openbio/single-cell/",
        "anndata_wire_type": "OPENBIO_ANNDATA",
        "artifact_wire_types": {
          "table": "OPENBIO_SINGLE_CELL_TABLE",
          "plot": "OPENBIO_SINGLE_CELL_PLOT",
          "summary": "OPENBIO_SINGLE_CELL_SUMMARY"
        },
        "analysis_object_wire_types": {
          "scvi_model": "OPENBIO_SCVI_MODEL",
          "scenic_network": "OPENBIO_SCENIC_NETWORK",
          "cassiopeia_tree": "OPENBIO_CASSIOPEIA_TREE"
        }
      }
    },
    "openbio_frontend_dist": {
      "path": "ComfyUI_frontend/dist",
      "build_command": "corepack pnpm build:openbio",
      "notice_command": "corepack pnpm exec node ../openbio-singlecell/scripts/generate_frontend_notices.mjs",
      "source_identity": "Source baseline commit and source-tree SHA-256 in THIRD_PARTY_NOTICES.md",
      "artifact_identity": "Frontend dist SHA-256 in THIRD_PARTY_NOTICES.md",
      "required_files": [
        "index.html",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md"
      ]
    }
  }
}
